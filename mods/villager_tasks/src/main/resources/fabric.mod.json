{
  "schemaVersion": 1,
  "id": "charmony-villager-tasks",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",

  "authors": [
    "svenhjol"
  ],
  "icon": "assets/charmony/textures/gui/sprites/charmony-villager-tasks.png",
  "license": "MIT",
  "environment": "*",
  "accessWidener": "charmony-villager-tasks.accesswidener",
  "entrypoints": {
    "main": [
      "charmony.villager_tasks.common.CommonInitializer"
    ],
    "client": [
      "charmony.villager_tasks.client.ClientInitializer"
    ]
  },

  "mixins": [
    "charmony-villager-tasks.common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "*",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "charmony": ">=${charmony_version}",
    "charmony-api": ">=${api_version}"
  },

  "contact": {
    "homepage": "${homepage_link}",
    "sources": "${sources_link}"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_link}"
      },
      "update_checker": true
    }
  }
}